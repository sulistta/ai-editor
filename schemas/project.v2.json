{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/project.v2.json",
  "title": "AI Video Editor Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "name", "revision", "settings", "assets", "sequences", "activeSequenceId", "transcripts"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "projectId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "settings": { "$ref": "#/$defs/projectSettings" },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/mediaAsset" } },
    "sequences": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sequence" } },
    "activeSequenceId": { "type": "string", "minLength": 1 },
    "transcripts": { "type": "array", "items": { "$ref": "#/$defs/transcript" } }
  },
  "$defs": {
    "projectSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fpsNum", "fpsDen", "sampleRate", "timebase"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fpsNum": { "type": "integer", "minimum": 1 },
        "fpsDen": { "type": "integer", "minimum": 1 },
        "sampleRate": { "type": "integer", "minimum": 8000 },
        "timebase": { "const": 240000 }
      }
    },
    "mediaAsset": {
      "type": "object",
      "required": ["id", "name", "durationTicks", "hasAudio", "offline"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "objectUrl": { "type": "string" },
        "durationTicks": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "codec": { "type": "string" },
        "hasAudio": { "type": "boolean" },
        "fingerprint": { "type": "string" },
        "proxyPath": { "type": "string" },
        "waveform": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 } },
        "offline": { "type": "boolean" }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "scale", "rotation", "opacity", "cropTop", "cropRight", "cropBottom", "cropLeft"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "rotation": { "type": "number" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "cropTop": { "type": "number", "minimum": 0, "maximum": 0.49 },
        "cropRight": { "type": "number", "minimum": 0, "maximum": 0.49 },
        "cropBottom": { "type": "number", "minimum": 0, "maximum": 0.49 },
        "cropLeft": { "type": "number", "minimum": 0, "maximum": 0.49 }
      }
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "offsetTick", "easing", "value"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "offsetTick": { "type": "integer", "minimum": 0 },
        "easing": { "enum": ["linear", "easeIn", "easeOut", "easeInOut"] },
        "value": { "$ref": "#/$defs/transform" }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "assetId", "name", "startTick", "sourceInTick", "durationTicks", "speed", "volume", "transform", "keyframes", "effects"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "assetId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "startTick": { "type": "integer", "minimum": 0 },
        "sourceInTick": { "type": "integer", "minimum": 0 },
        "durationTicks": { "type": "integer", "minimum": 1 },
        "speed": { "type": "number", "exclusiveMinimum": 0 },
        "volume": { "type": "number", "minimum": 0 },
        "transform": { "$ref": "#/$defs/transform" },
        "keyframes": { "type": "array", "items": { "$ref": "#/$defs/keyframe" } },
        "effects": { "type": "array", "items": { "type": "object" } },
        "transitionIn": { "type": "object" },
        "transitionOut": { "type": "object" }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "locked", "muted", "hidden", "clips"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["video", "audio", "caption"] },
        "locked": { "type": "boolean" },
        "muted": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "clips": { "type": "array", "items": { "$ref": "#/$defs/clip" } }
      }
    },
    "sequence": {
      "type": "object",
      "required": ["id", "name", "tracks", "markers", "captions", "captionStyle"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "tracks": { "type": "array", "items": { "$ref": "#/$defs/track" } },
        "markers": { "type": "array", "items": { "type": "object" } },
        "captions": { "type": "array", "items": { "type": "object" } },
        "captionStyle": { "type": "object" }
      }
    },
    "transcript": {
      "type": "object",
      "required": ["assetId", "engine", "model", "segments"],
      "properties": {
        "assetId": { "type": "string", "minLength": 1 },
        "engine": { "const": "whisper.cpp" },
        "model": { "type": "string", "minLength": 1 },
        "sourceFingerprint": { "type": "string" },
        "language": { "type": "string" },
        "segments": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
