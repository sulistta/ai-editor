{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/project.v1.json",
  "title": "AI Video Editor Project",
  "type": "object",
  "required": ["schemaVersion", "projectId", "name", "revision", "settings", "assets", "sequences", "activeSequenceId", "transcripts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": { "type": "string" },
    "name": { "type": "string" },
    "revision": { "type": "integer", "minimum": 0 },
    "settings": {
      "type": "object",
      "required": ["width", "height", "fpsNum", "fpsDen", "sampleRate", "timebase"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fpsNum": { "type": "integer", "minimum": 1 },
        "fpsDen": { "type": "integer", "minimum": 1 },
        "sampleRate": { "type": "integer", "minimum": 8000 },
        "timebase": { "const": 240000 }
      }
    },
    "assets": { "type": "array", "items": { "type": "object" } },
    "sequences": { "type": "array", "items": { "type": "object" } },
    "activeSequenceId": { "type": "string" },
    "transcripts": { "type": "array", "items": { "type": "object" } }
  }
}
